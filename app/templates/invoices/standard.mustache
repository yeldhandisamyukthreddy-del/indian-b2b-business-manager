<!DOCTYPE html>
<html lang="{{meta.lang}}" dir="{{meta.dir}}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{meta.documentTitle}}</title>
<!--style_start-->
<style>
{{>styles_base}}
{{>header_other_pages}}
</style>
<!--style_end-->
</head>
<body class="tpl-standard">
<main class="sheet" data-invoice-root>
{{>header}}
{{>subject_block}}
{{>line_item_table}}
<section class="after-items">
  <div class="after-left">
    {{#flags.isAmountInWordsRequired}}<div class="words"><div class="section-title">{{labels.amountInWords}}</div>{{totals.amountInWords}}</div>{{/flags.isAmountInWordsRequired}}
    {{>payment_details}}
  </div>
  <div class="after-right">{{>subtotal_block}}</div>
</section>
{{>tax_summary}}
{{>notes_terms}}
{{>footer}}
{{>payment_stub}}
</main>
</body>
</html>
